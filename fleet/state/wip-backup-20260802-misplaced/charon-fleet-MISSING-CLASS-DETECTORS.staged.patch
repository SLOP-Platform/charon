+#!/usr/bin/env bash
+# class-detectors.sh — MISSING-CLASS DETECTORS (build-rig only; report-only).
+#
+# WHY THIS EXISTS
+#   OPERATOR DIRECTIVE 2026-08-02: "anything with a lifecycle and no terminal gate accumulates."
+#   Mechanize a detector for EVERY accumulation class, run on cron cadence, surfaced LOUDLY at
+#   session start. FLEET-STATUS-BOARD supplies the registry + runner + meta-check; it can only
+#   register checks that EXIST. The following nine classes were measured accumulating today and had
+#   NO detector:
+#
+#     class                                   measured today
+#     uncommitted tools                       3 files, 362 lines, never in git AT ALL
+#     untracked reviews                       35 review logs, incl. NEEDS-REVISION
+#     cron registration                       crontab entry is untracked machine-local config
+#
+#   This file implements the three cheapest-and-git-only detectors first (uncommitted tools,
+#   untracked reviews, cron registration). The remaining six classes (config SSOT drift, deploy
+#   artifact drift, catalog/pricing rot, daemon outliving purpose, name pool exhaustion, operator
+#   action staleness) require network or live state and are handled in subsequent tickets.
+#
+# UNIFORM VERDICT CONTRACT
+#   Every detector emits the same output shape, consumed by one registry:
+#     CLASS_ID|OK|FINDING(n)|STALE|BROKEN  <one-line summary>  <recovery command>
+#   This mirrors the stranded-work.sh contract so the status board can consume all detectors
+#   uniformly. The format is intentionally easy to parse from shell.
+#
+# NEVER-FALSE-GREEN CONTRACT
+#   A detector that cannot determine its state must NOT report clean. BROKEN or STALE, never OK.
+#   A detector never seen to fire is not a detector — each one here has a fail-on-revert test
+#   that proves it fires on a seeded condition.
+#
+# NAMES
+#   Each detector function is named detect_<class-id> and registered in DETECTORS[] below.
+#   The class-id is the unique key used in the verdict output.
+#
+# REENTRANCY GUARD
+#   CLASS_DETECTORS_ACTIVE short-circuits any accidental nesting.
+set -eo pipefail
+
+[ -n "${CLASS_DETECTORS_ACTIVE:-}" ] && { echo "class-detectors: already running (reentrancy guard)"; exit 0; }
+export CLASS_DETECTORS_ACTIVE=1
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+FLEET="${CD_FLEET_DIR:-$(cd "$HERE/.." && pwd)}"
+STATE="${CD_STATE_DIR:-$FLEET/state}"
+
+declare -A DETECTORS=(
+  [uncommitted-tools]="detect_uncommitted_tools"
+  [untracked-reviews]="detect_untracked_reviews"
+  [cron-registration]="detect_cron_registration"
+)
+
+QUIET=0
+DETECTOR=""
+DETECTOR_ARG=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --quiet) QUIET=1 ;;
+    --run)
+      shift; DETECTOR_ARG="${1:-}"; [ -n "$DETECTOR_ARG" ] || { echo "usage: $0 --run <detector-id>" >&2; exit 2; } ;;
+    --list)
+      for _d in uncommitted-tools untracked-reviews cron-registration; do echo "$_d"; done
+      exit 0 ;;
+    *) echo "usage: $0 [--quiet|--list|--run <id>]" >&2; exit 2 ;;
+  esac
+  shift
+done
+DETECTOR="$DETECTOR_ARG"
+
+verdict(){ echo "$1  $2  $3"; }
+ok(){      verdict OK "$1" "no action needed"; }
+finding(){ verdict FINDING "$1" "$2"; }
+broken(){ verdict BROKEN "$1" "detector failed: $2"; }
+stale(){  verdict STALE "$1" "$2"; }
+detail(){ [ "$QUIET" -eq 1 ] || echo "$1"; }
+
+detect_uncommitted_tools(){
+  local repo="${CD_TOOLS_REPO:-$(cd "$FLEET/.." && pwd)}"
+  local glob="${CD_TOOLS_GLOB:-fleet/scripts fleet/tools}"
+  local count=0
+  for dir in $glob; do
+    local full="$repo/$dir"
+    [ -d "$full" ] || continue
+    while IFS= read -r f; do
+      [ -z "$f" ] && continue
+      count=$((count+1))
+      detail "  - ${f#$repo/}"
+    done < <(git -C "$repo" ls-files --others --exclude-standard "$dir" 2>/dev/null)
+  done
+  if [ "$count" -gt 0 ]; then
+    finding "uncommitted-tools" "$count untracked file(s) in scripts/tools dirs (never in git). Recover: git -C $repo add <path> && git -C $repo commit -m 'chore: add tool'"
+    return 1
+  fi
+  ok "uncommitted-tools" "no untracked tools in $repo"
+  return 0
+}
+
+detect_untracked_reviews(){
+  local repo="${CD_REVIEWS_REPO:-$(cd "$FLEET/.." && pwd)}"
+  local dir="${CD_REVIEWS_DIR:-docs/review-log}"
+  local full="$repo/$dir"
+  [ -d "$full" ] || { broken "untracked-reviews" "docs/review-log/ dir not found in $repo"; return 2; }
+  local count=0
+  while IFS= read -r f; do
+    [ -z "$f" ] && continue
+    count=$((count+1))
+    detail "  - ${f#$repo/}"
+  done < <(git -C "$repo" ls-files --others --exclude-standard "$dir" 2>/dev/null)
+  if [ "$count" -gt 0 ]; then
+    finding "untracked-reviews" "$count untracked review-log fragment(s) in $dir. Recover: git -C $repo add $dir/<id>.md && git -C $repo commit -m 'docs: add review log'"
+    return 1
+  fi
+  ok "untracked-reviews" "no untracked review logs in $repo/$dir"
+  return 0
+}
+
+detect_cron_registration(){
+  local cron_script="${CD_CRON_SCRIPT:-class-detectors.sh}"
+  if command -v crontab >/dev/null 2>&1; then
+    while IFS= read -r entry; do
+      [ -z "$entry" ] && continue
+      case "$entry" in '#'*) continue ;; esac
+      if printf '%s\n' "$entry" | grep -qF "$cron_script"; then
+        ok "cron-registration" "cron entry for $cron_script is registered"
+        return 0
+      fi
+    done < <(crontab -l 2>/dev/null)
+  fi
+  finding "cron-registration" "no cron entry for $cron_script found. Cadence-driven detectors without a registered cron entry will never fire. Recover: add '0 * * * * cd $FLEET && bash fleet/checks/$cron_script' to crontab"
+  return 1
+}
+
+run_one(){
+  local _wanted="$1"
+  local _fn="${DETECTORS[$_wanted]:-}"
+  [ -z "$_fn" ] && { echo "unknown detector: $_wanted" >&2; return 1; }
+  echo "--- $_wanted ---"
+  $_fn
+}
+
+if [ -n "$DETECTOR" ]; then
+  run_one "$DETECTOR"
+else
+  echo "--- class-detectors: MISSING-CLASS DETECTOR REGISTRY (REPORT ONLY) ---"
+  for _d in uncommitted-tools untracked-reviews cron-registration; do
+    run_one "$_d"
+  done
+fi
