+#!/usr/bin/env bash
+# class-detectors.test.sh — FAIL-ON-REVERT tests for fleet/checks/class-detectors.sh.
+#
+# WHY THESE ASSERTIONS EXIST
+#   OPERATOR DIRECTIVE 2026-08-02: "anything with a lifecycle and no terminal gate accumulates."
+#   A detector never seen to fire is not a detector — that is the 101-unrun-proof-suites class,
+#   and building it here would be self-refuting. Each detector therefore gets:
+#     (a) a baseline test: clean state produces OK or is skipped cleanly
+#     (b) a fail-on-revert test: a seeded finding proves the detector actually fires
+#
+# HERMETIC: real git repos built under mktemp -d, real file operations, and the REAL script.
+# Per-detector tests use --run to isolate each detector from the state left by prior tests.
+set -uo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+SCRIPT="$HERE/../checks/class-detectors.sh"
+
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
+
+REPO="$TMP/repo"; mkdir -p "$REPO"
+git init -q -b master "$REPO"
+echo initial > "$REPO/a.txt"; git -C "$REPO" add -A; git -C "$REPO" commit -qm init
+
+export CD_FLEET_DIR="$TMP/fleet" CLASS_DETECTORS_ACTIVE=""; mkdir -p "$CD_FLEET_DIR/state"
+
+run(){ bash "$SCRIPT" --quiet "$@" 2>&1; }
+run_one(){ bash "$SCRIPT" --quiet --run "$1" 2>&1; }
+
+contains(){ local hay="$1"; local needle="$2"; [ -z "${hay##*$needle*}" ]; }
+PASS=0; FAIL=0
+
+t(){
+  local name="$1"; local want="$2"; local have="$3"
+  if contains "$have" "$want"; then
+    PASS=$((PASS+1)); echo "  ok   $name"
+  else
+    FAIL=$((FAIL+1)); echo "  FAIL $name (missing: $want)"
+  fi
+}
+nt(){
+  local name="$1"; local want="$2"; local have="$3"
+  if contains "$have" "$want"; then
+    FAIL=$((FAIL+1)); echo "  FAIL $name (unexpected: $want)"
+  else
+    PASS=$((PASS+1)); echo "  ok   $name"
+  fi
+}
+rc(){
+  local name="$1"; local want="$2"; local have="$3"
+  if [ "$have" = "$want" ]; then
+    PASS=$((PASS+1)); echo "  ok   $name"
+  else
+    FAIL=$((FAIL+1)); echo "  FAIL $name (got $have, want $want)"
+  fi
+}
+
+echo "== A. uncommitted-tools: baseline clean (--run isolation) =="
+OUT="$(CD_TOOLS_REPO="$REPO" run_one uncommitted-tools)"; R=$?
+t "A1 OK verdict when clean" "OK  uncommitted-tools" "$OUT"
+rc "A2 rc=0 when clean" 0 "$R"
+
+echo "== B. uncommitted-tools: fail-on-revert — untracked script file =="
+mkdir -p "$REPO/fleet/scripts"
+echo '#!/bin/bash' > "$REPO/fleet/scripts/my-tool.sh"
+chmod +x "$REPO/fleet/scripts/my-tool.sh"
+OUT="$(CD_TOOLS_REPO="$REPO" run_one uncommitted-tools)"; R=$?
+t "B1 FINDING on untracked script" "FINDING  uncommitted-tools" "$OUT"
+nt "B2 does not also claim OK" "OK  uncommitted-tools" "$OUT"
+rc "B3 rc=1 on finding" 1 "$R"
+# Verify the finding counts the file (summary mentions the count, not the filename in --quiet mode)
+OUT_FULL="$(CD_TOOLS_REPO="$REPO" bash "$SCRIPT" --run uncommitted-tools 2>&1)"
+t "B4 detail line shows filename (full output)" "my-tool.sh" "$OUT_FULL"
+
+echo "== C. uncommitted-tools: multiple untracked files =="
+mkdir -p "$REPO/fleet/tools"
+echo '// another tool' > "$REPO/fleet/tools/my-lib.js"
+OUT="$(CD_TOOLS_REPO="$REPO" run_one uncommitted-tools)"; R=$?
+t "C1 count of 2 files reported" "2 untracked file" "$OUT"
+t "C2 shows FINDING (not OK) for dirty state" "FINDING  uncommitted-tools" "$OUT"
+
+echo "== D. uncommitted-tools: tracked file NOT flagged =="
+git -C "$REPO" add "fleet/scripts/my-tool.sh" "fleet/tools/my-lib.js"
+git -C "$REPO" commit -qm "add tools"
+OUT="$(CD_TOOLS_REPO="$REPO" run_one uncommitted-tools)"; R=$?
+t "D1 tracked file NOT flagged as uncommitted" "OK  uncommitted-tools" "$OUT"
+rc "D2 rc=0 after commit" 0 "$R"
+
+echo "== E. untracked-reviews: baseline clean =="
+mkdir -p "$REPO/docs/review-log"
+OUT="$(CD_REVIEWS_REPO="$REPO" run_one untracked-reviews)"; R=$?
+t "E1 OK verdict when no untracked reviews" "OK  untracked-reviews" "$OUT"
+rc "E2 rc=0 when clean" 0 "$R"
+
+echo "== F. untracked-reviews: fail-on-revert — untracked review fragment =="
+echo '# review fragment' > "$REPO/docs/review-log/UNTRACKED-REVIEW.md"
+OUT="$(CD_REVIEWS_REPO="$REPO" run_one untracked-reviews)"; R=$?
+t "F1 FINDING on untracked review" "FINDING  untracked-reviews" "$OUT"
+rc "F2 rc=1 on finding" 1 "$R"
+OUT_FULL="$(CD_REVIEWS_REPO="$REPO" bash "$SCRIPT" --run untracked-reviews 2>&1)"
+t "F3 detail line shows filename (full output)" "UNTRACKED-REVIEW.md" "$OUT_FULL"
+
+echo "== G. untracked-reviews: tracked review NOT flagged =="
+git -C "$REPO" add docs/review-log/UNTRACKED-REVIEW.md
+git -C "$REPO" commit -qm "add review"
+OUT="$(CD_REVIEWS_REPO="$REPO" run_one untracked-reviews)"; R=$?
+t "G1 tracked review NOT flagged" "OK  untracked-reviews" "$OUT"
+
+echo "== H. cron-registration: baseline — no cron entry =="
+OUT="$(run_one cron-registration)"; R=$?
+t "H1 FINDING when no cron entry" "FINDING  cron-registration" "$OUT"
+t "H2 mentions class-detectors.sh" "class-detectors.sh" "$OUT"
+rc "H3 rc=1 on finding" 1 "$R"
+
+echo "== I. cron-registration: with cron entry present =="
+(crontab -l 2>/dev/null; echo "0 * * * * cd $REPO && bash /tmp/class-detectors.sh") | crontab -
+OUT="$(run_one cron-registration)"; R=$?
+nt "I1 no FINDING when cron entry exists" "FINDING  cron-registration" "$OUT"
+crontab -r 2>/dev/null || true
+
+echo "== J. cron-registration: cron entry with wrong script name =="
+(crontab -l 2>/dev/null; echo "0 * * * * cd $REPO && bash wrong-script.sh") | crontab -
+OUT="$(run_one cron-registration)"; R=$?
+t "J1 FINDING when script name mismatches" "FINDING  cron-registration" "$OUT"
+crontab -r 2>/dev/null || true
+
+echo "== K. --list flag =="
+OUT="$(bash "$SCRIPT" --list 2>&1)"
+t "K1 --list shows uncommitted-tools" "uncommitted-tools" "$OUT"
+t "K2 --list shows untracked-reviews" "untracked-reviews" "$OUT"
+t "K3 --list shows cron-registration" "cron-registration" "$OUT"
+
+echo "== L. verdict contract: uniform format on full run =="
+OUT="$(run)"
+contains "$OUT" "OK  uncommitted-tools" && contains "$OUT" "FINDING  untracked-reviews" && PASS=$((PASS+1)) && echo "  ok   L1 verdict lines match contract" || { FAIL=$((FAIL+1)); echo "  FAIL L1 verdict lines match contract"; }
+
+echo "== M. reentrancy guard =="
+OUT="$(CLASS_DETECTORS_ACTIVE=1 run 2>&1)"
+t "M1 nested invocation exits 0 with guard" "already running (reentrancy guard)" "$OUT"
+
+echo ""
+echo "== RESULTS: $PASS passed, $FAIL failed =="
+[ "$FAIL" = 0 ] && exit 0 || exit 1
