diff --git a/fleet/benchmark/graders/preflight_checks/_pf_common.py b/fleet/benchmark/graders/preflight_checks/_pf_common.py
index f83730a..b02a913 100755
--- a/fleet/benchmark/graders/preflight_checks/_pf_common.py
+++ b/fleet/benchmark/graders/preflight_checks/_pf_common.py
@@ -172,10 +172,29 @@ def sha256_file(path: Path) -> str | None:
 # ── execution helpers (run product code, observe EFFECT) ─────────────────────
 
 def copy_to_scratch(worktree: Path) -> Path:
+    """Copy ``worktree`` into a private, WRITABLE scratch dir a grader can
+    mutate (e.g. to apply a behavioral mutant) without touching the daemon's
+    own read-only snapshot.
+
+    ROOT-CAUSE (b) FIX: the daemon's snapshot (grader-daemon.py
+    ``_snapshot_worktree``) is deliberately chmod'd read-only (0o444 files /
+    0o555 dirs) so the daemon itself can never mutate it. ``shutil.copytree``
+    defaults to ``copy2``, which PRESERVES those permission bits into the
+    scratch copy too — so any grader that writes into its scratch copy (e.g.
+    header-redaction-test.py applying a mutant to ``gateway/headers.py``)
+    crashed with ``PermissionError`` before it ever compared behavior,
+    surfacing as a uniform fail-closed BLOCK regardless of the model's actual
+    diff. Force the scratch copy writable immediately after the copy.
+    """
     scratch = Path(tempfile.mkdtemp(prefix="pf-grade-"))
     dest = scratch / "wt"
     shutil.copytree(worktree, dest,
                     ignore=shutil.ignore_patterns(*IGNORE_NAMES))
+    for p in dest.rglob("*"):
+        try:
+            p.chmod(0o755 if p.is_dir() else 0o644)
+        except OSError:
+            pass
     return dest
 
 
diff --git a/fleet/benchmark/preflight.sh b/fleet/benchmark/preflight.sh
index 0e7f8f7..2f382d2 100755
--- a/fleet/benchmark/preflight.sh
+++ b/fleet/benchmark/preflight.sh
@@ -214,6 +214,16 @@ main() {
     own_session_root=1
   fi
   mkdir -p "$session_root"
+  # mktemp -d hardcodes 0700 on the dir it creates. The grader-daemon runs as
+  # a DIFFERENT unix user (bench-grader) and must be able to traverse into
+  # this tree to snapshot the worktree for OOB grading (_snapshot_worktree in
+  # grader-daemon.py) — a 0700 session_root blocks that traversal even though
+  # every file/dir underneath is otherwise world-readable, causing every run
+  # to come back as a spurious daemon-side PermissionError (not a real
+  # pass/fail verdict). Relax just the top-level dir so the daemon can walk
+  # in; per-run dirs below are created via plain mkdir/tar and are already
+  # 0755 by default umask.
+  chmod 755 "$session_root" 2>/dev/null || true
   log "candidate model: $candidate"
   log "session root:    $session_root"
   log "runs per task:    $PFR_RUNS_N  (pass threshold: >=${PFR_PASS_NUM}/${PFR_PASS_DEN})"
@@ -247,6 +257,17 @@ main() {
         err "task=$task_id run=$i: model command not found/executable: $PFR_MODEL_CMD"
       fi
 
+      # Model/test tooling run in this worktree (e.g. hypothesis's cache
+      # writer) can leave files at 0600 or similar. The grader-daemon reads
+      # this tree as a DIFFERENT unix user (bench-grader) to snapshot it for
+      # OOB grading — an unreadable file anywhere in the tree aborts the
+      # whole snapshot with a PermissionError, which surfaces as a spurious
+      # daemon-side FAIL that has nothing to do with the candidate's actual
+      # task result. Force the tree world-readable/traversable right before
+      # handoff so grading reflects task correctness, not incidental tool
+      # umask/chmod behavior.
+      chmod -R a+rX "$session_dir" 2>/dev/null || true
+
       submit_grade_job "$run_id" "$candidate" "$grader_key" "$session_dir" \
         || { err "task=$task_id run=$i: could not submit grade job (spool write failed) — treating as FAIL"; continue; }
 
diff --git a/fleet/charon-run.sh b/fleet/charon-run.sh
index aa2e40c..41c9773 100755
--- a/fleet/charon-run.sh
+++ b/fleet/charon-run.sh
@@ -14,25 +14,86 @@ LEDGER="${CHARON_EXHAUST_LEDGER:-/home/stack/charon-private/fleet/provider-exhau
 if [ ! -f "$LEDGER" ]; then
   printf 'ts\tjob\tmodel\tevent\tnote\n' > "$LEDGER" 2>/dev/null || true
 fi
+# Per-attempt wall-clock budget. Default unchanged (1800s) for ordinary ticket
+# work; callers that want a tighter "too-slow == FAIL" budget (e.g. the
+# MODEL-PREFLIGHT battery) set CHARON_RUN_TIMEOUT_S in the environment.
+RUN_TIMEOUT_S="${CHARON_RUN_TIMEOUT_S:-1800}"
+# Where opencode's own structured log lives — used ONLY as a best-effort,
+# read-only signal to distinguish "model genuinely slow" from "gateway pool
+# exhausted and opencode silently retried in a loop" on a timeout. opencode's
+# CLI stdout does NOT surface "all providers exhausted" (confirmed: it hangs
+# silently until the outer `timeout` kills it), so without this the two cases
+# are indistinguishable from $OUT alone.
+OPENCODE_LOG="${OPENCODE_LOG:-$HOME/.local/share/opencode/log/opencode.log}"
  led() { printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$LABEL" "$1" "$2" "$3" >> "$LEDGER" 2>/dev/null || true; }
 for M in "${MODELS[@]}"; do
   echo "===== [charon-run] attempt: charon/$M @ $(basename "$CWD") =====" >> "$OUT"
   MARK=$(wc -l < "$OUT")
-  ( cd "$CWD" && timeout 1800 opencode run --model "charon/$M" "$PROMPT" ) >> "$OUT" 2>&1
+  ATTEMPT_START_EPOCH=$(date -u +%s)
+  ATTEMPT_START_ISO=$(date -u -d "@$ATTEMPT_START_EPOCH" +%FT%TZ 2>/dev/null || date -u +%FT%TZ)
+  ( cd "$CWD" && timeout -k 10 "$RUN_TIMEOUT_S" opencode run --model "charon/$M" "$PROMPT" ) >> "$OUT" 2>&1
   RC=$?
+  ATTEMPT_END_EPOCH=$(date -u +%s)
+  ELAPSED_S=$((ATTEMPT_END_EPOCH - ATTEMPT_START_EPOCH))
   TAIL=$(tail -n +"$MARK" "$OUT")
-  # Hard failure OR limit-signal in this attempt's tail -> fail over to next model.
-  if printf '%s' "$TAIL" | grep -qiE '\b429\b|rate.?limit|quota exceeded|insufficient (funds|credit|balance)|session limit|no capacity|model (is )?(over|exhausted)|out of (credit|quota)'; then
+
+  # real-diff-or-bail: did the model touch anything in the worktree beyond its
+  # own captured stdout log? (best-effort proxy; no git repo present in these
+  # session worktrees, so we use mtime-after-BRIEF-was-staged instead of a diff.)
+  CHANGED_N=$(find "$CWD" -type f -newer "$BRIEF" ! -name "$(basename "$OUT")" 2>/dev/null | wc -l | tr -d ' ')
+  if [ "${CHANGED_N:-0}" -gt 0 ]; then
+    DIFF_STATE="real-diff(files=$CHANGED_N)"
+  else
+    DIFF_STATE="bail-no-diff"
+  fi
+
+  # Best-effort provider attribution: NOT available client-side. opencode's
+  # own session DB/log only ever records providerID="charon" (the gateway
+  # alias) — the upstream sub-provider (nanoGPT/OpenRouter/etc) is never
+  # surfaced to the client. Real per-run attribution would need the GATEWAY's
+  # own request log (e.g. docker logs on the gateway host) correlated by
+  # timestamp+model — not reachable from this host in this session.
+  PROVIDER_NOTE="provider=unknown-clientside(gateway alias only; needs gateway-log correlation)"
+
+  echo "[charon-run] attempt-metrics model=$M elapsed_s=${ELAPSED_S} rc=$RC diff=$DIFF_STATE $PROVIDER_NOTE" >> "$OUT"
+
+  if [ "$RC" -eq 124 ]; then
+    # Timed out. Disambiguate: did opencode's own log show repeated
+    # "all providers exhausted" stream errors for this model during the
+    # attempt window (gateway-pool exhaustion masquerading as a hang), or
+    # nothing at all (a genuine slow-model / long-agentic-turn timeout)?
+    EXHAUST_HITS=0
+    if [ -f "$OPENCODE_LOG" ]; then
+      # Lines look like: timestamp=2026-07-13T20:25:23.537Z level=ERROR ... modelID=$M ... "all providers exhausted"
+      # Timestamps are ISO-8601 UTC -> lexical >= comparison against the
+      # attempt's own start timestamp is valid and cheap (no date parsing).
+      EXHAUST_HITS=$(awk -v m="modelID=$M" -v t0="$ATTEMPT_START_ISO" '
+        /^timestamp=/ && $0 ~ m && /all providers exhausted/ {
+          ts = substr($1, index($1, "=") + 1)
+          if (ts >= t0) c++
+        }
+        END { print c+0 }
+      ' "$OPENCODE_LOG" 2>/dev/null || echo 0)
+    fi
+    if [ "${EXHAUST_HITS:-0}" -gt 0 ]; then
+      echo "[charon-run] model '$M' TIMEOUT (rc=124, ${ELAPSED_S}s) — CAUSE: gateway pool exhausted (${EXHAUST_HITS}x 'all providers exhausted' in opencode log during this attempt) -> provider-side, not model-slow -> failing over" >> "$OUT"
+      led "$M" "timeout-pool-exhausted" "rc=124; elapsed_s=${ELAPSED_S}; ${EXHAUST_HITS}x all-providers-exhausted; ${DIFF_STATE}; try a different provider for this model"
+    else
+      echo "[charon-run] model '$M' TIMEOUT (rc=124, ${ELAPSED_S}s) — too-slow FAIL, no pool-exhaustion signal found -> failing over" >> "$OUT"
+      led "$M" "timeout-too-slow" "rc=124; elapsed_s=${ELAPSED_S}; ${DIFF_STATE}; latency-is-a-failure-class"
+    fi
+    continue
+  elif printf '%s' "$TAIL" | grep -qiE '\b429\b|rate.?limit|quota exceeded|insufficient (funds|credit|balance)|session limit|no capacity|model (is )?(over|exhausted)|out of (credit|quota)'; then
     echo "[charon-run] model '$M' hit a provider/session LIMIT -> failing over" >> "$OUT"
-    led "$M" "limit-failover" "rc=$RC; all providers for this model exhausted at gateway"
+    led "$M" "limit-failover" "rc=$RC; elapsed_s=${ELAPSED_S}; all providers for this model exhausted at gateway; ${DIFF_STATE}"
     continue
   elif [ "$RC" -ne 0 ]; then
-    echo "[charon-run] model '$M' exited nonzero (rc=$RC, not a limit) -> failing over" >> "$OUT"
-    led "$M" "error-failover" "rc=$RC; non-limit failure"
+    echo "[charon-run] model '$M' exited nonzero (rc=$RC, not a limit, not a timeout) -> failing over" >> "$OUT"
+    led "$M" "error-failover" "rc=$RC; elapsed_s=${ELAPSED_S}; non-limit failure; ${DIFF_STATE}"
     continue
   fi
-  echo "[charon-run] SUCCESS on model '$M' (rc=0)" >> "$OUT"
-  echo "CHARON_RUN_RESULT=SUCCESS model=$M" >> "$OUT"
+  echo "[charon-run] SUCCESS on model '$M' (rc=0, ${ELAPSED_S}s, $DIFF_STATE)" >> "$OUT"
+  echo "CHARON_RUN_RESULT=SUCCESS model=$M elapsed_s=${ELAPSED_S}" >> "$OUT"
   exit 0
 done
 echo "[charon-run] ALL MODELS EXHAUSTED: ${MODELS[*]}" >> "$OUT"
