diff --git a/tests/test_secrets.py b/tests/test_secrets.py
index c33b6f8..b64a372 100644
--- a/tests/test_secrets.py
+++ b/tests/test_secrets.py
@@ -124,3 +124,30 @@ def test_providers_add_custom_with_base_url(monkeypatch, tmp_path):
     rc = cli.main(["providers", "add", "mygw", "--base-url", "http://localhost:9/v1",
                    "--key-env", "MYGW_KEY", "--key", "secret"])
     assert rc == 0 and secrets.load_secrets()["MYGW_KEY"] == "secret"
+
+
+def test_apply_to_env_force_refresh_overwrites_resident(monkeypatch, tmp_path):
+    """Hot-rotation: a rotated key on disk must take effect live, overwriting the
+    stale value already resident in ``os.environ`` from process startup.
+
+    Without ``force_refresh`` the resident (stale) value must still win — this
+    is the explicit-env-wins invariant the rest of the suite relies on.
+    """
+    monkeypatch.setenv("CHARON_HOME", str(tmp_path))
+    monkeypatch.setenv("HF_TOKEN", "stale-token-from-startup")
+    try:
+        secrets.set_secret("HF_TOKEN", "rotated-token-on-disk")
+        # default call: resident stale value must still win (backward-compat)
+        secrets.apply_to_env()
+        assert os.environ["HF_TOKEN"] == "stale-token-from-startup"
+        # force_refresh: resident key is overwritten with the rotated on-disk value
+        secrets.apply_to_env(force_refresh=True)
+        assert os.environ["HF_TOKEN"] == "rotated-token-on-disk"
+        # a key that was never resident still loads in either mode
+        monkeypatch.delenv("CHARON_FRESH_KEY", raising=False)
+        secrets.set_secret("CHARON_FRESH_KEY", "fresh-value")
+        secrets.apply_to_env(force_refresh=True)
+        assert os.environ["CHARON_FRESH_KEY"] == "fresh-value"
+    finally:
+        os.environ.pop("HF_TOKEN", None)
+        os.environ.pop("CHARON_FRESH_KEY", None)
