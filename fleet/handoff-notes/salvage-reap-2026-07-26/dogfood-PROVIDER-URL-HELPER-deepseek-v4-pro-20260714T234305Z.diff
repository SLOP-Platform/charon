@@ -23,6 +23,21 @@ from urllib.parse import urlsplit
 from .netutil import BROWSER_UA  # shared browser-like UA (P5 — Cloudflare 1010)
 from .provider_presets import MERGED_RAW_DATA  # data merged from category modules
 
+
+def _join_endpoint(base_url: str, path: str) -> str:
+    """Join a *path* onto *base_url*, stripping trailing slashes from the base."""
+    return base_url.rstrip("/") + path
+
+
+def models_url(base_url: str) -> str:
+    """Return the resolved ``/models`` URL for *base_url*."""
+    return _join_endpoint(base_url, "/models")
+
+
+def chat_url(base_url: str) -> str:
+    """Return the resolved ``/chat/completions`` URL for *base_url*."""
+    return _join_endpoint(base_url, "/chat/completions")
+
