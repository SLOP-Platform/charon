+def test_models_url_base_with_path_segment():
+    assert providers.models_url("https://opencode.ai/zen/v1") == "https://opencode.ai/zen/v1/models"
+
+
+def test_models_url_trailing_slash():
+    assert providers.models_url("https://api.openai.com/v1/") == "https://api.openai.com/v1/models"
