+++ b/tests/test_providers.py
@@ -4,6 +4,7 @@ from __future__ import annotations
 import pytest
 
 from charon import gateway, providers
+from charon.providers import chat_url, models_url
 
 
 def test_all_presets_have_valid_http_base():
@@ -178,3 +179,62 @@ def test_extract_pricing_no_pricing_field():
     entry: dict = {}
     providers._extract_pricing({"id": "x"}, entry)
     assert entry == {}
+
+
+# ── PROVIDER-URL-HELPER: URL construction seam ─────────────────────
+
+def test_models_url_strips_trailing_slash():
+    # Normal base with a trailing slash — must be stripped before appending.
+    assert models_url("https://api.openai.com/v1/") == "https://api.openai.com/v1/models"
+
+
+def test_models_url_no_trailing_slash():
+    # Normal base WITHOUT a trailing slash — must still get exactly one ``/models`` suffix.
+    assert models_url("https://api.openai.com/v1") == "https://api.openai.com/v1/models"
+
+
+def test_models_url_base_with_path_segment():
+    # Base with a non-trivial path segment (``/zen/v1``) must preserve the
+    # existing segment AND append ``/models`` — no collapsing, no re-routing.
+    # This locks in the dedup behavior: every provider preset resolves to the
+    # EXACT SAME /models URL after this change as before.
+    assert models_url("https://opencode.ai/zen/v1") == "https://opencode.ai/zen/v1/models"
+    assert models_url("https://opencode.ai/zen/go/v1") == "https://opencode.ai/zen/go/v1/models"
+
+
+def test_models_url_v1_models_path():
+    # The strip_v1=False branch in ``discover.py`` appends ``/v1/models`` —
+    # the helper accepts an explicit path kwarg to preserve that distinction
+    # (no collapsing the /models vs /v1/models sites into one).
+    assert models_url("https://api.example.com", "/v1/models") == \
+        "https://api.example.com/v1/models"
+
+
+def test_models_url_strip_then_collapse_multiple_slashes():
+    # Multiple trailing slashes must collapse to a single ``/models`` join —
+    # mirrors the inline ``base.rstrip("/") + "/models"`` behavior.
+    assert models_url("https://api.example.com/v1///") == "https://api.example.com/v1/models"
+
+
+def test_chat_url_strips_trailing_slash():
+    # Normal base with a trailing slash — must be stripped before appending.
+    assert chat_url("https://api.openai.com/v1/") == \
+        "https://api.openai.com/v1/chat/completions"
+
+
+def test_chat_url_base_with_path_segment():
+    # Base with a non-trivial path segment must preserve the existing segment.
+    # The keyprobe validation probe uses this against e.g.
+    # ``https://opencode.ai/zen/v1`` — the resolved chat URL must NOT collapse
+    # the path segment.
+    assert chat_url("https://opencode.ai/zen/v1") == \
+        "https://opencode.ai/zen/v1/chat/completions"
+    assert chat_url("https://opencode.ai/zen/go/v1") == \
+        "https://opencode.ai/zen/go/v1/chat/completions"
+
+
+def test_chat_url_collapses_multiple_trailing_slashes():
+    # Multiple trailing slashes collapse to a single ``/chat/completions`` join —
+    # mirrors the inline ``base.rstrip("/") + "/chat/completions"`` behavior.
+    assert chat_url("https://api.example.com/v1///") == \
+        "https://api.example.com/v1/chat/completions"
