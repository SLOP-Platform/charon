 _MAX_MODELS_BYTES = 1_000_000  # cap the /models response (memory-DoS guard)
 
 
+def join_endpoint(base_url: str, path: str) -> str:
+    """Resolve ``base_url + path`` exactly as the inline ``base.rstrip('/') + path``
+    idiom has across this repo — single seam for "strip trailing slashes, append
+    a leading-slash endpoint". ``path`` MUST start with ``/``; this preserves the
+    existing behavior for bases with a non-trivial path (e.g.
+    ``https://opencode.ai/zen/v1`` + ``"/models`` → ``https://opencode.ai/zen/v1/models``)."""
+    return base_url.rstrip("/") + path
+
+
+def models_url(base_url: str, path: str = "/models") -> str:
+    """Resolve a provider's ``base_url`` to its ``/models`` (or, explicitly,
+    ``/v1/models``) endpoint URL — the single seam that replaces the inline
+    ``base.rstrip("/") + "/models"`` / ``+ "/v1/models"`` sites in ``discover.py``
+    and ``list_models`` here. Default ``path="/models"``; pass ``"/v1/models"`` to
+    preserve the strip_v1=False branch in ``discover.py`` (no collapsing — the
+    two call sites resolve to different suffixes for a reason)."""
+    return join_endpoint(base_url, path)
+
+
+def chat_url(base_url: str) -> str:
+    """Resolve a provider's ``base_url`` to its ``/chat/completions`` endpoint URL —
+    the single seam that replaces the inline ``base.rstrip("/") + "/chat/completions"``
+    site in ``config/keyprobe.py``."""
+    return join_endpoint(base_url, "/chat/completions")
+
+
 def _is_free(item: dict) -> bool:
     """Best-effort free detection from an OpenAI-style /models entry: an OpenRouter
     ``:free`` id suffix, or a ``pricing`` map whose prompt+completion are all 0."""
