+def test_apply_to_env_force_refresh_overwrites_resident(monkeypatch, tmp_path):
+    monkeypatch.setenv("CHARON_HOME", str(tmp_path))
+    key = "CHARON_HOTROTATE_KEY"
+    secrets.set_secret(key, "new-value")
+    try:
+        monkeypatch.setenv(key, "stale-value")
+        # Without force_refresh, should keep stale-value
+        secrets.apply_to_env(force_refresh=False)
+        assert os.environ[key] == "stale-value"
+        # With force_refresh, should update to new-value
+        secrets.apply_to_env(force_refresh=True)
+        assert os.environ[key] == "new-value"
+    finally:
+        os.environ.pop(key, None)
+
