     k: ProviderPreset(**v) for k, v in MERGED_RAW_DATA.items()}
 
 
+def join_endpoint(base_url: str, path: str) -> str:
+    """Strip trailing slashes from *base_url* and append *path*."""
+    return base_url.rstrip("/") + path
+
+
+def models_url(base_url: str) -> str:
+    """Return the resolved ``/models`` URL for *base_url*."""
+    return join_endpoint(base_url, "/models")
+
+
+def chat_url(base_url: str) -> str:
+    """Return the resolved ``/chat/completions`` URL for *base_url*."""
+    return join_endpoint(base_url, "/chat/completions")
+
+
