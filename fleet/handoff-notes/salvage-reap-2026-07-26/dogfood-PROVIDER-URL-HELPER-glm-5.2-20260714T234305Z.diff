diff --git a/tests/test_providers.py b/tests/test_providers.py
index e250906..e402208 100644
--- a/tests/test_providers.py
+++ b/tests/test_providers.py
@@ -178,3 +178,56 @@ def test_extract_pricing_no_pricing_field():
     entry: dict = {}
     providers._extract_pricing({"id": "x"}, entry)
     assert entry == {}
+
+
+# ── URL construction: models_url / chat_url (single seam) ────────────────────
+# ``base.rstrip("/") + "/models"`` was reimplemented inline in several places; the
+# helpers below are the one true seam. A base with a non-trivial path segment
+# (e.g. the opencode-zen ``https://opencode.ai/zen/v1``) must resolve identically
+# to a plain ``https://host/v1`` base — trailing-slash-stripped, suffix appended.
+
+def test_models_url_plain_base():
+    assert providers.models_url("https://api.openai.com/v1") == \
+        "https://api.openai.com/v1/models"
+
+
+def test_models_url_base_with_path_segment():
+    # opencode-zen ships a base URL that already carries a path: /zen/v1
+    assert providers.models_url("https://opencode.ai/zen/v1") == \
+        "https://opencode.ai/zen/v1/models"
+
+
+def test_models_url_strips_trailing_slash():
+    assert providers.models_url("https://api.openai.com/v1/") == \
+        "https://api.openai.com/v1/models"
+    assert providers.models_url("https://host/v1///") == "https://host/v1/models"
+
+
+def test_chat_url_plain_base():
+    assert providers.chat_url("https://api.openai.com/v1") == \
+        "https://api.openai.com/v1/chat/completions"
+
+
+def test_chat_url_base_with_path_segment():
+    # opencode-go base: https://opencode.ai/zen/go/v1
+    assert providers.chat_url("https://opencode.ai/zen/go/v1") == \
+        "https://opencode.ai/zen/go/v1/chat/completions"
+
+
+def test_chat_url_strips_trailing_slash():
+    assert providers.chat_url("https://api.openai.com/v1/") == \
+        "https://api.openai.com/v1/chat/completions"
+
+
+def test_models_url_matches_real_preset_base():
+    # Every existing provider preset must resolve to the EXACT same /models URL
+    # the old inline ``base.rstrip("/") + "/models"`` produced.
+    for name, p in providers.PRESETS.items():
+        expected = p.base_url.rstrip("/") + "/models"
+        assert providers.models_url(p.base_url) == expected, name
+
+
+def test_chat_url_matches_real_preset_base():
+    for name, p in providers.PRESETS.items():
+        expected = p.base_url.rstrip("/") + "/chat/completions"
+        assert providers.chat_url(p.base_url) == expected, name
