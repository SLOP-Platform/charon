+# ── Provider URL construction (single seam for base → endpoint) ──────────────
+# Every call site that turns a stored ``base_url`` into a concrete ``/models``
+# or ``/chat/completions`` URL goes through these helpers, so trailing-slash and
+# path-joining edge cases (e.g. bases with a non-trivial path such as
+# ``https://opencode.ai/zen/v1``) are handled in ONE place.
+def join_endpoint(base_url: str, path: str) -> str:
+    """Strip trailing slashes from *base_url* and append *path* (which must
+    start with ``/``). The single seam for constructing a provider endpoint URL
+    from a stored base — no inline ``rstrip("/") + "/..."`` anywhere else."""
+    return base_url.rstrip("/") + path
+
+
+def models_url(base_url: str) -> str:
+    """Resolve a provider ``base_url`` to its ``/models`` endpoint."""
+    return join_endpoint(base_url, "/models")
+
+
+def chat_url(base_url: str) -> str:
+    """Resolve a provider ``base_url`` to its ``/chat/completions`` endpoint."""
+    return join_endpoint(base_url, "/chat/completions")
+
+
 class _NoRedirect(urllib.request.HTTPRedirectHandler):
     """Refuse redirects — a redirect could carry the ``Authorization`` Bearer to
     another host (urllib does NOT strip it cross-host). Key-exfil guard."""
