diff --git a/src/charon/secrets.py b/src/charon/secrets.py
index 9bf96bc..bb352ca 100644
--- a/src/charon/secrets.py
+++ b/src/charon/secrets.py
@@ -87,11 +87,20 @@ def set_secret(key_env: str, value: str) -> Path:
     return p
 
 
-def apply_to_env() -> None:
-    """Load stored secrets into ``os.environ`` without overriding anything already
-    set — an explicit environment variable always wins. Only well-formed key-env
-    names are loaded, and loader-sensitive vars (PATH, LD_PRELOAD, …) are never
-    injected from the file (defense-in-depth)."""
+def apply_to_env(*, force_refresh: bool = False) -> None:
+    """Load stored secrets into ``os.environ``.
+
+    By default an already-resident environment variable always wins
+    (``setdefault`` semantics).  Pass *force_refresh=True* to overwrite a
+    resident key with the current on-disk value so that a rotated key takes
+    effect live without a process restart.
+
+    Only well-formed key-env names are loaded, and loader-sensitive vars
+    (PATH, LD_PRELOAD, …) are never injected from the file (defense-in-depth).
+    """
     for k, v in load_secrets().items():
         if _KEY_ENV_RE.match(k) and k not in _SENSITIVE_ENV:
-            os.environ.setdefault(k, v)
+            if force_refresh:
+                os.environ[k] = v
+            else:
+                os.environ.setdefault(k, v)
diff --git a/tests/test_secrets.py b/tests/test_secrets.py
index c33b6f8..d340355 100644
--- a/tests/test_secrets.py
+++ b/tests/test_secrets.py
@@ -124,3 +124,30 @@ def test_providers_add_custom_with_base_url(monkeypatch, tmp_path):
     rc = cli.main(["providers", "add", "mygw", "--base-url", "http://localhost:9/v1",
                    "--key-env", "MYGW_KEY", "--key", "secret"])
     assert rc == 0 and secrets.load_secrets()["MYGW_KEY"] == "secret"
+
+
+def test_force_refresh_overwrites_resident_key(monkeypatch, tmp_path):
+    monkeypatch.setenv("CHARON_HOME", str(tmp_path))
+    secrets.set_secret("HOTROTATE_KEY", "rotated")
+    monkeypatch.setenv("HOTROTATE_KEY", "stale")
+    assert os.environ["HOTROTATE_KEY"] == "stale"
+    secrets.apply_to_env(force_refresh=False)
+    assert os.environ["HOTROTATE_KEY"] == "stale"
+    secrets.apply_to_env(force_refresh=True)
+    assert os.environ["HOTROTATE_KEY"] == "rotated"
+
+
+def test_hot_rotate_skips_sensitive_keys(monkeypatch, tmp_path):
+    monkeypatch.setenv("CHARON_HOME", str(tmp_path))
+    (tmp_path / "secrets.json").write_text(
+        '{"LD_PRELOAD": "/evil.so", "GOOD_KEY": "stored"}')
+    monkeypatch.setenv("LD_PRELOAD", "/existing.so")
+    for v in ("GOOD_KEY",):
+        monkeypatch.delenv(v, raising=False)
+    secrets.apply_to_env(force_refresh=True)
+    try:
+        assert os.environ["LD_PRELOAD"] == "/existing.so"  # sensitive never overwritten
+        assert os.environ.get("GOOD_KEY") == "stored"
+    finally:
+        os.environ.pop("GOOD_KEY", None)
+        os.environ.pop("LD_PRELOAD", None)
