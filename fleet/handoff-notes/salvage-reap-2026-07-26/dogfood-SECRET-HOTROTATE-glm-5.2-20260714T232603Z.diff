+def test_apply_to_env_force_refresh_overrides_stale_resident(monkeypatch, tmp_path):
+    """Hot rotation: force_refresh=True overwrites a stale resident env var with
+    the newly rotated on-disk value, while the default call leaves the stale
+    value in place."""
+    monkeypatch.setenv("CHARON_HOME", str(tmp_path))
+    secrets.set_secret("CHARON_ROTATE_KEY", "new-value")
+    try:
+        monkeypatch.setenv("CHARON_ROTATE_KEY", "old-value")  # stale resident value
+        # default — resident (stale) value wins
+        secrets.apply_to_env()
+        assert os.environ["CHARON_ROTATE_KEY"] == "old-value"
+        # force_refresh — rotated on-disk value overwrites the stale resident
+        secrets.apply_to_env(force_refresh=True)
+        assert os.environ["CHARON_ROTATE_KEY"] == "new-value"
+    finally:
+        os.environ.pop("CHARON_ROTATE_KEY", None)
+
+
+def test_apply_to_env_force_refresh_skips_sensitive_and_malformed(monkeypatch, tmp_path):
+    """force_refresh never weakens the sensitive/malformed guards."""
+    monkeypatch.setenv("CHARON_HOME", str(tmp_path))
+    (tmp_path / "secrets.json").write_text(
+        '{"LD_PRELOAD": "/evil.so", "PATH": "/evil", "bad name": "x", "GOOD_KEY": "ok"}')
+    for v in ("LD_PRELOAD", "GOOD_KEY"):
+        monkeypatch.delenv(v, raising=False)
+    secrets.apply_to_env(force_refresh=True)
+    try:
+        assert os.environ.get("GOOD_KEY") == "ok"      # normal key loads
+        assert "LD_PRELOAD" not in os.environ          # loader-sensitive still skipped
+        assert "bad name" not in os.environ            # malformed name still skipped
+    finally:
+        os.environ.pop("GOOD_KEY", None)
+
+
