+def join_endpoint(base_url: str, path: str) -> str:
+    """Strip trailing slashes from *base_url* and join with *path*."""
+    return base_url.rstrip("/") + "/" + path.lstrip("/")
+
+
+def models_url(base_url: str) -> str:
+    """Resolve a provider's /models URL (base already includes /v1)."""
+    return join_endpoint(base_url, "models")
+
+
+def chat_url(base_url: str) -> str:
+    """Resolve a provider's /chat/completions URL."""
+    return join_endpoint(base_url, "chat/completions")
+
+
