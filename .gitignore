# --- secrets: NEVER commit ---
test-keys.env
*.env
!*.example.env

# --- nested git/bare repos ---
charon-rebuild-backup.git/

# --- ephemeral fleet runtime state (claims/submitted/done markers) ---
fleet/state/*
# ...except the persisted roadmap (canonical source for report.sh/handoff.sh).
!fleet/state/ROADMAP.tsv
# ...except the REVIEWER-DOGFOOD-REDS ground-truth corpus (durable, git-tracked by
# design — see REDS-CORPUS.md's own OOB design note).
!fleet/state/REDS-CORPUS.md
# ...except the bidirectional rule-coverage audit register (RULE-SYNC-AUDIT
# ticket) — durable, derived from the sibling frameworks' inventories.
!fleet/state/RULE-SYNC-REGISTER.tsv
# ...except the config-drift source registry (CONFIG-SOURCES ticket) — local + gateway,
# durable; config-drift.sh reads this to detect provider siloing.
!fleet/state/CONFIG-SOURCES.tsv

# --- scratch / logs ---
*.log
fleet/logs/
__pycache__/
*.pyc
fleet/state/overnight/

# auto-gen REDS registry (regenerated by build-rig; never source-tracked)
fleet/reds.tsv

# runtime artifacts (regenerated; never source-tracked)
fleet/scorecard.v1.json
fleet/provider-exhaustion-ledger.tsv
fleet/model-scorecard.tsv
